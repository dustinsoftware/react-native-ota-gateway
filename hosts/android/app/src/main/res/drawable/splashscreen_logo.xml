<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. The platform scales windowSplashScreenAnimatedIcon
     to fill its 288dp slot, so the logo cannot simply be a bitmap at its
     intrinsic size: a transparent 288dp base layer fixes the drawable's
     intrinsic size and the logo is centred at 76dp inside it, which is what
     app.json's expo-splash-screen imageWidth: 76 asks for. Scaling the 288dp
     drawable then scales the logo proportionally. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@android:color/transparent"
        android:gravity="center" />
    <item
        android:width="76dp"
        android:height="76dp"
        android:drawable="@drawable/splashscreen_logo_image"
        android:gravity="center" />
</layer-list>
