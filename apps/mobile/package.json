{
  "name": "@ota-gateway/mobile",
  "main": "./src/brownfield/entry.tsx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export": "node scripts/export-web.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "brownfield:package:ios": "./scripts/package-ios.sh",
    "brownfield:publish:android": "OTA_ENVIRONMENT=production brownfield publish:android --module-name otagatewaylib",
    "release:frameworks": "node scripts/create-release.mjs",
    "install:ios": "node scripts/install-ios-frameworks.mjs"
  },
  "dependencies": {
    "@callstack/react-native-brownfield": "3.6.1",
    "@expo/metro-runtime": "55.0.10",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "55.0.19",
    "expo-build-properties": "55.0.15",
    "expo-constants": "55.0.15",
    "expo-dev-client": "55.0.27",
    "expo-linking": "55.0.14",
    "expo-router": "55.0.13",
    "expo-secure-store": "55.0.9",
    "expo-server": "55.0.6",
    "expo-splash-screen": "55.0.19",
    "expo-status-bar": "55.0.5",
    "expo-system-ui": "55.0.16",
    "expo-updates": "55.0.20",
    "express": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@callstack/brownfield-cli": "3.6.1",
    "@expo/code-signing-certificates": "0.0.6",
    "@types/express": "^5.0.6",
    "@types/react": "~19.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  }
}
