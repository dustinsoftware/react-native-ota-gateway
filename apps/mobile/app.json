{
  "expo": {
    "name": "ota-gateway-app",
    "slug": "ota-gateway-app",
    "version": "0.1.0",
    "runtimeVersion": "1",
    "updates": {
      "url": "http://localhost:3001/api/v2/updates/manifest",
      "checkAutomatically": "ALWAYS",
      "enabled": true,
      "useEmbeddedUpdate": false,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "extra": {
      "gatewayUrls": {
        "development": "http://localhost:3000",
        "production": "http://localhost:3001"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "otagatewayapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.otagateway.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.otagateway",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "ccacheEnabled": true
          }
        }
      ],
      "./plugins/withBrownfieldUpdates.js",
      "./plugins/withBrownfieldAndroidPublishing.js",
      [
        "@callstack/react-native-brownfield",
        {
          "ios": {
            "frameworkName": "OtaGatewayLib",
            "bundleIdentifier": "dev.otagateway.app.brownfield"
          },
          "android": {
            "moduleName": "otagatewaylib",
            "packageName": "dev.otagateway"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
